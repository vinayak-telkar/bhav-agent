# Free inference only — no paid API key required anywhere in this project.
# Get a free key at https://console.groq.com (no credit card) and, optionally,
# https://cloud.cerebras.ai for the fallback provider.
#
# Model catalogs on free tiers change over time — verify these strings against each
# provider's live model list before relying on them. See TECH_SPEC.md §11 and
# specs/02_langgraph_mcp_spike.md for the day-1 verification step.
# Last verified: 2026-08-02 (unverified against live catalogs — confirm on M0).

GROQ_API_KEY=
CEREBRAS_API_KEY=

DIGEST_PROVIDER=groq
DIGEST_MODEL=openai/gpt-oss-120b
DIGEST_FALLBACK_PROVIDER=cerebras
DIGEST_FALLBACK_MODEL=

CHAT_PROVIDER=groq
CHAT_MODEL=llama-3.3-70b-versatile
CHAT_FALLBACK_PROVIDER=cerebras
CHAT_FALLBACK_MODEL=

DATABASE_PATH=../data/bhav.db
